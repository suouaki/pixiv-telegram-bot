# Telegram Bot Token (从 @BotFather 获取)
TELEGRAM_BOT_TOKEN=7750782004:AAEfcbjyR6wI273f9ksFleDV72JezlO3Ve4

# Pixiv 登录 Cookie (选填，若需下载 R-18 限制作品或 R-18 动图则必填)
# 获取方法: 浏览器登录 pixiv.net -> 开发者工具 F12 -> Application -> Cookies -> 复制 PHPSESSID
# 格式例如: PHPSESSID=10381692_xxxxxx 或直接填字符串
PIXIV_COOKIE=

# 动图默认渲染格式: mp4 或 gif (推荐 mp4，体积小、Telegram 原生循环播放)
UGOIRA_OUTPUT_FORMAT=mp4

# 发送模式: document_and_photo | photo_only | document_only
SEND_MODE=document_and_photo

# 若服务器位于受限网络环境，可配置 HTTP/SOCKS5 代理
# PROXY_URL=http://127.0.0.1:7890

# Group Chat ID (群聊 ID，可选填)
GROUP_CHAT_ID=
BOT_PASSWORD=
